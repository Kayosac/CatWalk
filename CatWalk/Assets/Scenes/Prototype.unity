  m_Script: {fileID: 11500000, guid: efc731476274445a4bf5d15eee143fee, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  id: slip
  conditions:
  - fact: trickster.met
    compare: 0
    value: 2
  radius: 5
  byCar: 0
  needKey: 0
  delay: 1.5
  text: "\u0422\u0438\u043C (\u0432\u043F\u043E\u043B\u0433\u043E\u043B\u043E\u0441\u0430,
    \u043D\u0435 \u0442\u0435\u0431\u0435): \xAB\u041E\u043F\u044F\u0442\u044C \u044D\u0442\u043E\u0442,
    \u0432 \u0448\u0430\u0440\u0444\u0435, \u043F\u0440\u043E \u0440\u0443\u0438\u043D\u044B
    \u0440\u0430\u0441\u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u043B. \u041F\u0440\u043E\u0448\u043B\u043E\u0433\u043E,
    \u043A\u0442\u043E \u0441 \u043D\u0438\u043C \u043B\u0435\u0442\u0430\u043B,
    \u0442\u0443\u0442 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0432\u0438\u0434\u043D\u043E\xBB."
