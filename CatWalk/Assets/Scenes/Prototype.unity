      value: "\u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
        \u043C\u0430\u044F\u043A: \xAB\u042E\u043B\u0430 \u2014 \u0433\u0430\u0437\u043E\u0432\u044B\u0439
