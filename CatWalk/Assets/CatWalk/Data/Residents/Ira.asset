  m_Script: {fileID: 11500000, guid: 037bd214d400b45898c20dc70a2745b9, type: 3}
  m_Name: Ira
  m_EditorClassIdentifier: 
  displayName: "\u0418\u0440\u0430"
  greeting: "\u0421\u0442\u043E\u0439! \u0428\u0443\u0447\u0443, \u0434\u0432\u0438\u0433\u0430\u0439\u0441\u044F.
    \u042F \u0418\u0440\u0430, \u0437\u0430\u043F\u0440\u0430\u0432\u043A\u0430 \u043C\u043E\u044F.
    \u041A\u0430\u0441\u043A\u0443 \u043D\u0435 \u0441\u043D\u0438\u043C\u0430\u044E
    \u2014 \u043E\u043D\u0430 \u043C\u0435\u043D\u044F \u0442\u043E\u0436\u0435."
  greetingKnown: "\u0410, \u043A\u0443\u0440\u044C\u0435\u0440. \u0411\u0430\u043A
    \u043D\u0435 \u0442\u0435\u0447\u0451\u0442? \u0425\u0432\u043E\u0441\u0442 \u043D\u0435
    \u0432 \u043C\u0430\u0437\u0443\u0442\u0435? \u041D\u0443 \u0438 \u0441\u043B\u0430\u0432\u043D\u043E."
  greetingWarm: "\u041C\u043E\u0439 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0439
    \u043A\u043B\u0438\u0435\u043D\u0442! \u041F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0445
    \u0443 \u043C\u0435\u043D\u044F \u0440\u043E\u0432\u043D\u043E \u043E\u0434\u0438\u043D.
    \u041A\u0430\u0441\u043A\u0430 \u0440\u0430\u0434\u0430, \u044F \u0442\u043E\u0436\u0435."
  warmDeliveries: 3
  topics:
  - "\u041D\u0430\u0441\u043E\u0441 \u0441 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043E\u043C:
    \u043F\u043E \u0432\u0442\u043E\u0440\u043D\u0438\u043A\u0430\u043C \u043A\u0430\u0447\u0430\u0435\u0442
    \u0442\u043E\u043B\u044C\u043A\u043E \u0432 \u043E\u0431\u0440\u0430\u0442\u043D\u0443\u044E
    \u0441\u0442\u043E\u0440\u043E\u043D\u0443. \u0421\u0435\u0433\u043E\u0434\u043D\u044F
    \u0432\u0440\u043E\u0434\u0435 \u043D\u0435 \u0432\u0442\u043E\u0440\u043D\u0438\u043A."
  - "\u041F\u0440\u043E\u0432\u0435\u0440\u044F\u0439 \u0431\u0430\u043A \u0434\u043E
    \u0432\u044B\u043B\u0435\u0442\u0430. \u041F\u043E\u0441\u043B\u0435 \u0432\u044B\u043B\u0435\u0442\u0430
    \u0442\u043E\u0436\u0435 \u043C\u043E\u0436\u043D\u043E, \u043D\u043E \u0443\u0436\u0435
    \u043D\u0435\u0440\u0432\u043D\u043E."
  - "\u041B\u043E\u0432\u0438\u043C \u043E\u0434\u043D\u0443 \u0440\u0430\u0434\u0438\u043E\u0441\u0442\u0430\u043D\u0446\u0438\u044E.
    \u0422\u0430\u043C \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u043B\u0435\u0442
    \u0438\u0433\u0440\u0430\u0435\u0442 \u043E\u0434\u043D\u0430 \u043F\u0435\u0441\u043D\u044F.
    \u042F \u0432\u044B\u0443\u0447\u0438\u043B\u0430 \u0441\u043B\u043E\u0432\u0430.
    \u0421\u043B\u043E\u0432 \u0442\u0430\u043C \u043D\u0435\u0442."
  - "\u041A\u0430\u0441\u043A\u0430 \u2014 \u043E\u0442 \u043F\u0430\u0434\u0430\u044E\u0449\u0438\u0445
    \u0433\u0430\u0435\u0447\u043D\u044B\u0445 \u043A\u043B\u044E\u0447\u0435\u0439.
    \u041C\u043E\u0438\u0445. \u042F \u0438\u0445 \u0440\u043E\u043D\u044F\u044E
    \u0441 \u0431\u043E\u043B\u044C\u0448\u0438\u043C \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u0438\u0437\u043C\u043E\u043C."
  thanks: "\u041F\u0440\u0438\u043D\u044F\u0442\u043E. \u0420\u0430\u0441\u043F\u0438\u0448\u0438\u0441\u044C
    \u043B\u0430\u043F\u043E\u0439 \u0432\u043E\u0442 \u0442\u0443\u0442. \u041D\u0435\u0442,
    \u0434\u0440\u0443\u0433\u043E\u0439. \u041B\u0430\u0434\u043D\u043E, \u043B\u044E\u0431\u043E\u0439."
  reactions:
  - order: {fileID: 11400000, guid: 744e2cffc2afe4ae683d1ddb13428026, type: 2}
    line: "\u041F\u0438\u0441\u044C\u043C\u0430! \u0426\u0435\u043B\u0430\u044F \u043F\u0430\u0447\u043A\u0430!
      \u0411\u0443\u0434\u0443 \u0447\u0438\u0442\u0430\u0442\u044C \u043F\u043E
      \u043E\u0434\u043D\u043E\u043C\u0443 \u0432 \u043D\u0435\u0434\u0435\u043B\u044E,
      \u0447\u0442\u043E\u0431 \u043D\u0430\u0434\u043E\u043B\u0433\u043E \u0445\u0432\u0430\u0442\u0438\u043B\u043E."
  - order: {fileID: 11400000, guid: b02d7a89d0b6249c6a958a025a545b37, type: 2}
    line: "\u041B\u0430\u043F\u0448\u0430! \u0417\u0430\u0432\u0430\u0440\u044E \u043D\u0430
      \u0432\u044B\u0445\u043B\u043E\u043F\u0435 \u043D\u0430\u0441\u043E\u0441\u0430.
      \u0428\u0443\u0447\u0443. \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435.
      \u0421\u043F\u0430\u0441\u0438\u0431\u043E!"
  damagedRemark: "\u041A\u043E\u0440\u043E\u0431\u043A\u0430 \u0431\u0438\u0442\u0430\u044F.
    \u041D\u0435 \u0441\u0442\u0440\u0430\u0448\u043D\u043E, \u044F \u0442\u0443\u0442
    \u0432\u0441\u0451 \u0447\u0438\u043D\u044E. \u041A\u0440\u043E\u043C\u0435 \u043A\u043E\u0440\u043E\u0431\u043E\u043A.
    \u041A\u043E\u0440\u043E\u0431\u043A\u0438 \u2014 \u044D\u0442\u043E \u0442\u044B."
  story:
  - id: ira-1
    line: "\u0417\u0430\u043F\u0440\u0430\u0432\u043A\u0443 \u044F \u0432\u044B\u0438\u0433\u0440\u0430\u043B\u0430
      \u0432 \u043B\u043E\u0442\u0435\u0440\u0435\u044E. \u0411\u0438\u043B\u0435\u0442
      \u0431\u044B\u043B \u043D\u0430 \u043F\u044B\u043B\u0435\u0441\u043E\u0441.
      \u0414\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u043D\u0435 \u0443\u0432\u0435\u0440\u0435\u043D\u0430,
      \u0447\u0442\u043E \u0432\u044B\u0438\u0433\u0440\u0430\u043B\u0430."
    minDeliveries: 1
    after: 
  - id: ira-2
    line: "\u0412\u0447\u0435\u0440\u0430 \u043F\u043E \u0440\u0430\u0434\u0438\u043E
      \u0437\u0430\u0438\u0433\u0440\u0430\u043B\u0430 \u0434\u0440\u0443\u0433\u0430\u044F
      \u043F\u0435\u0441\u043D\u044F. \u042F \u0442\u0430\u043A \u0438\u0441\u043F\u0443\u0433\u0430\u043B\u0430\u0441\u044C,
      \u0447\u0442\u043E \u0432\u044B\u043A\u043B\u044E\u0447\u0438\u043B\u0430.
      \u041F\u043E\u0442\u043E\u043C \u0432\u0435\u0441\u044C \u0434\u0435\u043D\u044C
      \u0441\u043A\u0443\u0447\u0430\u043B\u0430."
    minDeliveries: 3
    after: ira-1
  moods:
  - when:
    - fact: errand.heat
      compare: 0
      value: 3
    greeting: "\u0421\u043B\u0443\u0448\u0430\u0439, \u0442\u0443\u0442 \u043F\u0430\u0442\u0440\u0443\u043B\u044C
      \u0437\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u043B\u0441\u044F. \u0421\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u043B
      \u043F\u0440\u043E \u043A\u0443\u0440\u044C\u0435\u0440\u0430. \u042F \u0441\u043A\u0430\u0437\u0430\u043B\u0430,
      \u0447\u0442\u043E \u043A\u0443\u0440\u044C\u0435\u0440\u044B \u2014 \u044D\u0442\u043E
      \u043C\u0438\u0444."
    topics: []
  - when:
    - fact: errand.ira-noodles
      compare: 0
      value: 2
    greeting: "\u041D\u043E\u0432\u044B\u0439 \u043D\u0430\u0441\u043E\u0441 \u043A\u0430\u0447\u0430\u0435\u0442
      \u0432 \u043E\u0431\u0435 \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u0438
      \u0434\u0430\u0436\u0435 \u043F\u043E \u0432\u0442\u043E\u0440\u043D\u0438\u043A\u0430\u043C.
      \u041D\u0435 \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0441 \u044D\u0442\u0438\u043C
      \u0434\u0435\u043B\u0430\u0442\u044C."
    topics:
    - "\u0421\u0442\u0430\u0440\u044B\u0439 \u043D\u0430\u0441\u043E\u0441 \u0442\u0435\u043F\u0435\u0440\u044C
      \u0443 \u0411\u0440\u0443\u043D\u043E. \u0413\u043E\u0432\u043E\u0440\u0438\u0442,
      \u043F\u043E \u0432\u0442\u043E\u0440\u043D\u0438\u043A\u0430\u043C \u043A\u0430\u0447\u0430\u0435\u0442
      \u043F\u0435\u0441\u043E\u043A. \u041E\u0431\u0440\u0430\u0442\u043D\u043E."
    - "\u041A\u0430\u0441\u043A\u0430 \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C
      \u043F\u0440\u0435\u0436\u043D\u044F\u044F. \u0414\u043E\u043B\u0436\u043D\u043E
      \u0436\u0435 \u0432 \u0436\u0438\u0437\u043D\u0438 \u0431\u044B\u0442\u044C
      \u0447\u0442\u043E-\u0442\u043E \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0435."
  errands:
