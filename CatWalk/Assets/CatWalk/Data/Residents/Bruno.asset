  m_Script: {fileID: 11500000, guid: 037bd214d400b45898c20dc70a2745b9, type: 3}
  m_Name: Bruno
  m_EditorClassIdentifier: 
  displayName: "\u0411\u0440\u0443\u043D\u043E"
  greeting: "\u041E, \u043A\u0443\u0440\u044C\u0435\u0440! \u0421\u043D\u0438\u043C\u0438
    \u043E\u0431\u0443\u0432\u044C \u2014 \u0448\u0443\u0447\u0443, \u0442\u0443\u0442
    \u0432\u0435\u0437\u0434\u0435 \u043F\u0435\u0441\u043E\u043A."
  greetingKnown: "\u041E\u043F\u044F\u0442\u044C \u0442\u044B. \u0425\u043E\u0440\u043E\u0448\u043E.
    \u041F\u0435\u0441\u043E\u043A \u043F\u043E \u0442\u0435\u0431\u0435 \u0441\u043A\u0443\u0447\u0430\u043B."
  greetingWarm: "\u0421\u0432\u043E\u0438 \u043F\u0440\u0438\u0448\u043B\u0438! \u0421\u0430\u0434\u0438\u0441\u044C
    \u043D\u0430 \u044F\u0449\u0438\u043A, \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0435
    \u043D\u0430 \u0442\u043E\u0442, \u043E\u043D \u0441 \u0434\u0438\u043D\u0430\u043C\u0438\u0442\u043E\u043C.
    \u0428\u0443\u0447\u0443. \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435."
  warmDeliveries: 3
  topics:
  - "\u041E\u0445\u0440\u0430 \u043A\u0440\u0430\u0441\u043D\u0430\u044F, \u043F\u043E\u0442\u043E\u043C\u0443
    \u0447\u0442\u043E \u0440\u0436\u0430\u0432\u0430\u044F. \u0418\u043B\u0438 \u0441\u0442\u0435\u0441\u043D\u044F\u0435\u0442\u0441\u044F.
    \u042F \u043D\u0435 \u0443\u0442\u043E\u0447\u043D\u044F\u043B."
  - "\u041D\u0430\u0448\u0451\u043B \u0432\u0447\u0435\u0440\u0430 \u043A\u0430\u043C\u0435\u043D\u044C
    \u0432 \u0444\u043E\u0440\u043C\u0435 \u0440\u044B\u0431\u044B. \u0421\u0435\u0433\u043E\u0434\u043D\u044F
    \u2014 \u0432 \u0444\u043E\u0440\u043C\u0435 \u0432\u0442\u043E\u0440\u043E\u0439
    \u0440\u044B\u0431\u044B. \u041A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u044F
    \u0440\u0430\u0441\u0442\u0451\u0442."
  - "\u041A\u0430\u0441\u043A\u0430 \u0441 \u0444\u043E\u043D\u0430\u0440\u0451\u043C
    \u2014 \u043B\u0443\u0447\u0448\u0438\u0439 \u0434\u0440\u0443\u0433. \u0412\u0442\u043E\u0440\u043E\u0439
    \u043B\u0443\u0447\u0448\u0438\u0439 \u2014 \u0442\u0435\u0440\u043C\u043E\u0441.
    \u0422\u0440\u0435\u0442\u0438\u0439 \u2014 \u0442\u044B, \u0435\u0441\u043B\u0438
    \u043F\u0440\u0438\u0432\u0451\u0437 \u043B\u0430\u043C\u043F\u044B."
  - "\u041D\u043E\u0447\u044C\u044E \u043F\u0435\u0441\u043E\u043A \u043F\u043E\u0451\u0442.
    \u0422\u0438\u0445\u043E \u0442\u0430\u043A, \u0431\u0430\u0441\u043E\u043C.
    \u0421\u043F\u0430\u0442\u044C \u043C\u0435\u0448\u0430\u0435\u0442, \u043D\u043E
    \u043A\u0440\u0430\u0441\u0438\u0432\u043E."
  thanks: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0434\u0440\u0443\u0436\u0438\u0449\u0435.
    \u041F\u0440\u0438\u0438\u0441\u043A \u043E\u0446\u0435\u043D\u0438\u0442. \u041D\u0443,
    \u044F \u043E\u0446\u0435\u043D\u044E, \u043F\u0440\u0438\u0438\u0441\u043A \u2014
    \u044D\u0442\u043E \u044F."
  reactions:
  - order: {fileID: 11400000, guid: feecf3ce2e1a64ec2889905314461ca3, type: 2}
    line: "\u041D\u0430\u0441\u043E\u0441! \u0411\u0435\u0437 \u043D\u043E\u043C\u0435\u0440\u0430!
      \u041C\u043E\u0439 \u043B\u044E\u0431\u0438\u043C\u044B\u0439 \u0432\u0438\u0434
      \u043D\u0430\u0441\u043E\u0441\u043E\u0432. \u0418\u0440\u0435 \u0441\u043A\u0430\u0436\u0438
      \u2014 \u043D\u043E\u0432\u044B\u0439 \u0437\u0430 \u043C\u043D\u043E\u0439."
  - order: {fileID: 11400000, guid: 6ede6e9aea6be4b238abfaed45178295, type: 2}
    line: "\u041B\u0430\u043F\u0448\u0430! \u041A\u0443\u0440\u0441 \u0441\u043E\u0431\u043B\u044E\u0434\u0451\u043D.
      \u041D\u0430\u0441\u043E\u0441 \u0418\u0440\u0435 \u0443\u0436\u0435 \u043B\u0435\u0442\u0438\u0442.
      \u041D\u0443, \u043B\u0435\u0436\u0438\u0442. \u0421\u043A\u043E\u0440\u043E
      \u043F\u043E\u043B\u0435\u0442\u0438\u0442."
  damagedRemark: "\u041A\u043E\u0440\u043E\u0431\u043A\u0430 \u043F\u043E\u043C\u044F\u0442\u0430...
    \u041D\u0443 \u043D\u0438\u0447\u0435\u0433\u043E, \u0443 \u043D\u0430\u0441
    \u0442\u0443\u0442 \u0432\u0441\u0451 \u043F\u043E\u043C\u044F\u0442\u043E\u0435,
    \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u043C\u0435\u043D\u044F."
  story:
  - id: bruno-1
    line: "\u0417\u043D\u0430\u0435\u0448\u044C, \u043F\u043E\u0447\u0435\u043C\u0443
      \u044F \u0442\u0443\u0442 \u043E\u0434\u0438\u043D? \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0443\u0435\u0445\u0430\u043B\u0438, \u0430 \u044F \u043E\u0441\u0442\u0430\u043B\u0441\u044F
      \u0436\u0434\u0430\u0442\u044C, \u043A\u043E\u0433\u0434\u0430 \u0440\u0443\u0434\u0430
      \u043A\u043E\u043D\u0447\u0438\u0442\u0441\u044F. \u041D\u0435 \u043A\u043E\u043D\u0447\u0430\u0435\u0442\u0441\u044F."
    minDeliveries: 1
    after: 
  - id: bruno-2
    line: "\u042F \u0440\u0430\u043D\u044C\u0448\u0435 \u043F\u0435\u043B \u0432
      \u0445\u043E\u0440\u0435 \u043D\u0430 \u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u0441\u0442\u0430\u043D\u0446\u0438\u0438. \u0422\u0443\u0442 \u0445\u043E\u0440
      \u2014 \u0432\u0435\u0442\u0435\u0440 \u0438 \u044F. \u0412\u0435\u0442\u0435\u0440
      \u0444\u0430\u043B\u044C\u0448\u0438\u0432\u0438\u0442."
    minDeliveries: 3
    after: bruno-1
  moods:
  - when:
    - fact: errand.bruno-fish
      compare: 1
      value: -1
    greeting: "\u042F\u0449\u0438\u043A \u0437\u0430\u0431\u0440\u0430\u043B\u0438?
      \u041D\u0443... \u0440\u044B\u0431\u0430 \u0443\u043F\u043B\u044B\u043B\u0430.
      \u0411\u044B\u0432\u0430\u0435\u0442. \u041E\u0431\u044B\u0447\u043D\u043E
      \u043D\u0435 \u0441\u043E \u043C\u043D\u043E\u0439."
    topics: []
  - when:
    - fact: errand.bruno-fish2
      compare: 1
      value: -1
    greeting: "\u0411\u043E\u043B\u044C\u0448\u0443\u044E \u0440\u044B\u0431\u0443
      \u0437\u0430\u0431\u0440\u0430\u043B\u0438? \u0418\u043D\u0441\u043F\u0435\u043A\u0446\u0438\u044F
      \u0442\u0435\u043F\u0435\u0440\u044C \u0435\u0441\u0442 \u0445\u043E\u0440\u043E\u0448\u043E.
      \u0425\u043E\u0442\u044C \u043A\u0442\u043E-\u0442\u043E."
    topics: []
  - when:
    - fact: errand.bruno-fish2
      compare: 0
      value: 2
    greeting: "\u041F\u0430\u0440\u0442\u043D\u0451\u0440! \u0412\u0438\u0434\u0438\u0448\u044C
      \u044F\u0449\u0438\u043A\u0438? \u041D\u0435 \u0432\u0438\u0434\u0438\u0448\u044C.
      \u0412\u043E\u0442 \u0438 \u043C\u043E\u043B\u043E\u0434\u0435\u0446."
    topics:
    - "\u0411\u0438\u0437\u043D\u0435\u0441 \u0440\u0430\u0441\u0442\u0451\u0442.
      \u0420\u0443\u0434\u0430 \u0442\u043E\u0436\u0435. \u041E\u043D\u0430 \u0442\u0435\u043F\u0435\u0440\u044C
      \u0432 \u0444\u043E\u0440\u043C\u0435 \u0440\u044B\u0431\u044B \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E.
      \u041F\u043E\u0447\u0442\u0438."
    - "\u041B\u0430\u043C\u043F\u0443 \u043F\u043E\u0432\u0435\u0441\u0438\u043B,
      \u0447\u0442\u043E\u0431\u044B \u043A\u043B\u0438\u0435\u043D\u0442\u044B \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438.
      \u041A\u043B\u0438\u0435\u043D\u0442\u043E\u0432 \u043D\u0435\u0442, \u043D\u043E
      \u043B\u0430\u043C\u043F\u0430 \u043A\u0440\u0430\u0441\u0438\u0432\u0430\u044F."
  errands:
  - {fileID: 11400000, guid: 50177348b17f14f8b85f4bc65e666dac, type: 2}
  - {fileID: 11400000, guid: ad4886e85dfd94c35b6a351b6decb31c, type: 2}
