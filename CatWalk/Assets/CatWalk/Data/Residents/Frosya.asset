  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 037bd214d400b45898c20dc70a2745b9, type: 3}
  m_Name: Frosya
  m_EditorClassIdentifier: 
  displayName: "\u0424\u0440\u043E\u0441\u044F"
  greeting: "\u041E\u0439. \u0413\u043E\u0441\u0442\u0438. \u042F \u0424\u0440\u043E\u0441\u044F.
    \u0421\u0432\u0435\u0442 \u043D\u0430 \u043E\u043A\u043D\u0435 \u0432\u0438\u0434\u0435\u043B?
    \u042D\u0442\u043E \u043C\u043E\u0439. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
    \u043E\u043A\u043D\u0430 \u043D\u0435 \u043C\u043E\u0438 \u2014 \u0438\u0445
    \u0445\u043E\u0437\u044F\u0435\u0432\u0430 \u0440\u0430\u0437\u044A\u0435\u0445\u0430\u043B\u0438\u0441\u044C."
  greetingKnown: "\u0410, \u043A\u0443\u0440\u044C\u0435\u0440. \u041F\u0440\u043E\u0445\u043E\u0434\u0438,
    \u043B\u0430\u043F\u044B \u043D\u0435 \u0432\u044B\u0442\u0438\u0440\u0430\u0439
    \u2014 \u0442\u0443\u0442 \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u043D\u0438\u043A\u043E\u0433\u043E,
    \u043A\u0442\u043E \u0437\u0430\u0440\u0443\u0433\u0430\u0435\u0442\u0441\u044F."
  greetingWarm: "\u041C\u043E\u0439 \u043A\u0443\u0440\u044C\u0435\u0440! \u042F
    \u0442\u0435\u043F\u0435\u0440\u044C \u0441\u0432\u0435\u0442 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E
    \u0438 \u0434\u043B\u044F \u0442\u0435\u0431\u044F. \u0420\u0430\u043D\u044C\u0448\u0435
    \u2014 \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043B\u044F \u0442\u0435\u0445,
    \u043A\u0442\u043E \u043D\u0435 \u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F."
  warmDeliveries: 3
  topics:
  - "\u0420\u0430\u043D\u044C\u0448\u0435 \u043D\u0430 \u0413\u0430\u043B\u044C\u043A\u0435
    \u0431\u044B\u043B\u043E \u0441\u043E\u0440\u043E\u043A \u043E\u043A\u043E\u043D.
    \u0422\u0435\u043F\u0435\u0440\u044C \u043E\u0434\u043D\u043E. \u0417\u0430\u0442\u043E
    \u0435\u0433\u043E \u0432\u0438\u0434\u043D\u043E \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430
    \u2014 \u043F\u0440\u043E\u0432\u0435\u0440\u0435\u043D\u043E."
  - "\u041B\u0430\u043C\u043F\u0443 \u043C\u0435\u043D\u044F\u044E \u0440\u0430\u0437
    \u0432 \u0433\u043E\u0434. \u041B\u0430\u043C\u043F\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u0442,
    \u0447\u0442\u043E \u0443\u0441\u0442\u0430\u043B\u0430. \u042F \u0433\u043E\u0432\u043E\u0440\u044E
    \u2014 \u044F \u0442\u043E\u0436\u0435, \u0438 \u043D\u0438\u0447\u0435\u0433\u043E."
  - "\u041F\u043E\u0447\u0442\u0443 \u0441\u044E\u0434\u0430 \u043D\u0435 \u0432\u043E\u0437\u044F\u0442.
    \u0422\u043E \u0435\u0441\u0442\u044C \u0432\u043E\u0437\u044F\u0442: \u0442\u044B.
    \u0417\u043D\u0430\u0447\u0438\u0442, \u0432\u043E\u0437\u044F\u0442."
  - "\u0421\u043E\u0441\u0435\u0434\u0438 \u043F\u0438\u0441\u0430\u043B\u0438, \u0447\u0442\u043E
    \u0432\u0435\u0440\u043D\u0443\u0442\u0441\u044F, \u043A\u043E\u0433\u0434\u0430
    \u0441\u0442\u0430\u043D\u0435\u0442 \u043B\u0443\u0447\u0448\u0435. \u041F\u043E\u043A\u0430
    \u043D\u0435 \u0441\u0442\u0430\u043B\u043E. \u042F \u0436\u0434\u0443, \u043C\u043D\u0435
    \u043D\u0435 \u0442\u0440\u0443\u0434\u043D\u043E."
  thanks: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E. \u041F\u043E\u043B\u043E\u0436\u0443
    \u0443 \u043E\u043A\u043D\u0430 \u2014 \u043F\u0443\u0441\u0442\u044C \u0441\u0432\u0435\u0442
    \u043D\u0430 \u043D\u0435\u0451 \u0442\u043E\u0436\u0435 \u0441\u0432\u0435\u0442\u0438\u0442."
  reactions:
  - order: {fileID: 11400000, guid: cd71fbc546faf43dfa0cf8fd94b8baaa, type: 2}
    line: "\u0427\u0430\u0439! \u0417\u0430\u0432\u0430\u0440\u044E \u0434\u0432\u0435
      \u043A\u0440\u0443\u0436\u043A\u0438. \u041E\u0434\u043D\u0443 \u0442\u0435\u0431\u0435,
      \u043E\u0434\u043D\u0443 \u2014 \u043F\u043E \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u0435."
  - order: {fileID: 11400000, guid: ef8c9a542c0c940499cb2823bae8b142, type: 2}
    line: "\u041B\u0430\u043C\u043F\u043E\u0447\u043A\u0438! \u0422\u0435\u043F\u0435\u0440\u044C
      \u043E\u043A\u043D\u043E \u043D\u0435 \u043F\u043E\u0433\u0430\u0441\u043D\u0435\u0442
      \u0435\u0449\u0451 \u043B\u0435\u0442 \u0434\u0435\u0441\u044F\u0442\u044C.
      \u0415\u0441\u043B\u0438 \u044F \u043D\u0435 \u043F\u043E\u0433\u0430\u0441\u043D\u0443
      \u0440\u0430\u043D\u044C\u0448\u0435. \u0428\u0443\u0447\u0443. \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435."
  damagedRemark: "\u041A\u043E\u0440\u043E\u0431\u043A\u0430 \u043F\u043E\u0431\u0438\u043B\u0430\u0441\u044C.
    \u041D\u0438\u0447\u0435\u0433\u043E, \u0442\u0443\u0442 \u0432\u0441\u0451 \u043D\u0435\u043C\u043D\u043E\u0436\u043A\u043E
    \u043F\u043E\u0431\u0438\u0442\u043E\u0435. \u042F \u0442\u043E\u0436\u0435."
  story:
  - id: frosya-1
    line: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0441\u0432\u0435\u0442? \u0422\u0443\u0442
      \u0431\u044B\u043B \u0443\u0437\u0435\u043B, \u0441\u043E\u0440\u043E\u043A
      \u043E\u043A\u043E\u043D, \u0432\u0441\u0435 \u0433\u043E\u0440\u0435\u043B\u0438.
      \u041F\u043E\u0442\u043E\u043C \u0442\u0440\u0430\u0441\u0441\u0443 \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u043B\u0438.
      \u0415\u0441\u043B\u0438 \u0438 \u044F \u043F\u043E\u0433\u0430\u0448\u0443
      \u2014 \u0413\u0430\u043B\u044C\u043A\u0438 \u043D\u0435 \u0441\u0442\u0430\u043D\u0435\u0442
      \u0434\u0430\u0436\u0435 \u043D\u0430 \u043A\u0430\u0440\u0442\u0435."
    minDeliveries: 1
    after: 
  - id: frosya-2
    line: "\u0412\u0447\u0435\u0440\u0430 \u043A\u0442\u043E-\u0442\u043E \u043C\u0438\u0433\u043D\u0443\u043B
      \u0444\u0430\u0440\u0430\u043C\u0438, \u043F\u0440\u043E\u043B\u0435\u0442\u0430\u044F.
      \u042F \u043C\u0438\u0433\u043D\u0443\u043B\u0430 \u043E\u043A\u043D\u043E\u043C
      \u0432 \u043E\u0442\u0432\u0435\u0442. \u042D\u0442\u043E \u0442\u0435\u043F\u0435\u0440\u044C
      \u043D\u0430\u0448 \u0441 \u043D\u0438\u043C \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440."
    minDeliveries: 3
    after: frosya-1
  moods: []
  errands: []
