  offer: "\u0415\u0441\u0442\u044C \u0434\u0435\u043B\u043E... \u041A\u043E \u043C\u043D\u0435
    \u043F\u0440\u0438\u043B\u0435\u0442\u0435\u043B \u0437\u043E\u043D\u0434 \u0421\u0430\u0438.
    \u0421\u0430\u043C. \u0412\u0435\u0440\u043D\u0438 \u0435\u0433\u043E, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430,
    \u0441 \u0438\u0437\u0432\u0438\u043D\u0435\u043D\u0438\u044F\u043C\u0438 \u043E\u0442
    \u0437\u043E\u043D\u0434\u0430. \u042F \u0438\u0445 \u0437\u0430\u043F\u0438\u0441\u0430\u043B."
  accepted: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E. \u041E\u043D \u043D\u0435
    \u0442\u044F\u0436\u0451\u043B\u044B\u0439, \u043F\u0440\u043E\u0441\u0442\u043E
    \u0435\u043C\u0443 \u0441\u0442\u044B\u0434\u043D\u043E."
  refused: "\u041B\u0430\u0434\u043D\u043E. \u041F\u0443\u0441\u0442\u044C \u043F\u043E\u0436\u0438\u0432\u0451\u0442
    \u0443 \u043C\u0435\u043D\u044F. \u0411\u0443\u0434\u0435\u043C \u043C\u043E\u043B\u0447\u0430\u0442\u044C
    \u0432 \u043F\u0443\u0441\u0442\u043E\u0442\u0443 \u0432\u0434\u0432\u043E\u0451\u043C."
  done: "\u0422\u0438\u043C: \xAB\u0421\u0430\u044F \u043F\u0438\u0448\u0435\u0442,
    \u0437\u043E\u043D\u0434 \u0434\u043E\u043C\u0430. \u041E\u0431\u0435\u0449\u0430\u043B
    \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0443\u043B\u0435\u0442\u0430\u0442\u044C.
    \u0412\u0440\u0451\u0442, \u043A\u043E\u043D\u0435\u0447\u043D\u043E\xBB."
