  offer: "\u0415\u0441\u0442\u044C \u0434\u0435\u043B\u043E... \u042F\u0449\u0438\u043A
    \u043A\u0430\u043C\u043D\u0435\u0439 \u0432 \u0444\u043E\u0440\u043C\u0435 \u0440\u044B\u0431\u044B.
    \u0422\u0438\u043C\u0443. \u0415\u0441\u043B\u0438 \u0441\u043F\u0440\u043E\u0441\u044F\u0442
    \u2014 \u044D\u0442\u043E \u0440\u044B\u0431\u0430. \u0415\u0441\u043B\u0438
    \u0441\u043F\u0440\u043E\u0441\u044F\u0442, \u043F\u043E\u0447\u0435\u043C\u0443
    \u0442\u044F\u0436\u0451\u043B\u0430\u044F, \u2014 \u0440\u044B\u0431\u0430 \u0442\u043E\u043B\u0441\u0442\u0430\u044F."
  accepted: "\u0420\u044B\u0431\u0430 \u043F\u043E\u0435\u0445\u0430\u043B\u0430!
    \u0414\u0435\u0440\u0436\u0438\u0441\u044C \u0434\u0430\u043B\u044C\u043D\u0438\u0445
    \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u043E\u0432, \u0442\u0430\u043C \u043D\u0438\u043A\u0442\u043E
    \u043D\u0435 \u0441\u043C\u043E\u0442\u0440\u0438\u0442."
  refused: "\u0418 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E. \u0427\u0435\u0441\u0442\u043D\u044B\u0439
    \u043A\u0443\u0440\u044C\u0435\u0440 \u2014 \u0440\u0435\u0434\u043A\u0438\u0439
    \u0432\u0438\u0434. \u041A\u0430\u043A \u0440\u044B\u0431\u0430 \u0438\u0437
    \u043A\u0430\u043C\u043D\u044F."
  done: "\u0411\u0440\u0443\u043D\u043E: \xAB\u0422\u0438\u043C \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B!
    \u041A\u0441\u0442\u0430\u0442\u0438, \u043A\u0440\u0435\u0434\u0438\u0442\u043E\u0440\u044B
    \u043E\u0442\u043A\u0443\u0434\u0430-\u0442\u043E \u0443\u0437\u043D\u0430\u043B\u0438,
    \u0447\u0442\u043E \u0443 \u0442\u0435\u0431\u044F \u0437\u0430\u0432\u0435\u043B\u0438\u0441\u044C
    \u0434\u0435\u043D\u044C\u0433\u0438\xBB."
