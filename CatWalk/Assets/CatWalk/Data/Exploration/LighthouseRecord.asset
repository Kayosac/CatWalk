  m_Script: {fileID: 11500000, guid: 1b75d7b79bc3d490eb8f0dc63d6f2320, type: 3}
  m_Name: LighthouseRecord
  m_EditorClassIdentifier: 
  title: "\u0417\u0430\u043F\u0438\u0441\u044C \u043C\u0430\u044F\u043A\u0430"
  parts:
  - id: keeper-1
    text: "...\u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043C\u0430\u044F\u043A
      \u043D\u0430 \u043A\u0440\u0430\u044E, \u0441\u043C\u0435\u043D\u0430 \u0441\u043E\u0440\u043E\u043A
      \u043E\u0434\u0438\u043D. \u0422\u0440\u0430\u0441\u0441\u0430 \u0447\u0438\u0441\u0442\u0430\u044F.
      \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043F\u0440\u043E\u0448\u043B\u043E
      \u0434\u0435\u0432\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u0431\u043E\u0440\u0442\u043E\u0432,
      \u043E\u0434\u0438\u043D \u043F\u043E\u043C\u0430\u0445\u0430\u043B. \u0417\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u044E,
      \u0435\u0441\u043B\u0438 \u0432\u0434\u0440\u0443\u0433 \u043A\u0442\u043E
      \u0441\u043F\u0440\u043E\u0441\u0438\u0442, \u043A\u0430\u043A \u0442\u0443\u0442
      \u0431\u044B\u043B\u043E."
    conditions: []
  - id: keeper-2
    text: "...\u0441\u043C\u0435\u043D\u0430 \u0441\u0442\u043E \u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u044C.
      \u0411\u043E\u0440\u0442\u043E\u0432 \u2014 \u0442\u0440\u0438. \u041F\u043E\u0447\u0442\u043E\u0432\u044B\u0439
      \u043F\u0440\u0438\u0432\u0451\u0437 \u043F\u0438\u0440\u043E\u0433 \u043E\u0442
      \u0441\u0435\u0441\u0442\u0440\u044B \u0438\u0437 \u0413\u0430\u0432\u0430\u043D\u0438.
      \u041F\u0438\u0440\u043E\u0433 \u043F\u043E\u043C\u044F\u043B\u0441\u044F,
      \u043D\u043E \u0431\u044B\u043B \u0432\u043A\u0443\u0441\u043D\u044B\u0439.
      \u0421\u0432\u0435\u0442 \u0441\u0434\u0435\u043B\u0430\u044E \u043F\u043E\u044F\u0440\u0447\u0435."
    conditions:
    - fact: visits.lighthouse
      compare: 0
      value: 2
  - id: keeper-3
    text: "...\u0441\u043C\u0435\u043D\u0430 \u0442\u0440\u0438\u0441\u0442\u0430
      \u043A\u0430\u043A\u0430\u044F-\u0442\u043E. \u0422\u0440\u0430\u0441\u0441\u0443
      \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u043B\u0438. \u0421\u043A\u0430\u0437\u0430\u043B\u0438:
      \u043C\u0430\u044F\u043A \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435
      \u043D\u0443\u0436\u0435\u043D. \u042F \u0441\u043A\u0430\u0437\u0430\u043B,
      \u0447\u0442\u043E \u0435\u043C\u0443 \u0432\u0438\u0434\u043D\u0435\u0435.
      \u0421\u0432\u0435\u0442 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E.
      \u0418 \u043F\u043E\u0447\u0442\u0443 \u043D\u0430 \u0441\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u043A\u0435
      \u2014 \u0442\u043E\u0436\u0435 \u043A\u0442\u043E-\u0442\u043E \u043E\u0441\u0442\u0430\u0432\u0438\u043B."
    conditions:
    - fact: visits.lighthouse
      compare: 0
      value: 3
    - fact: delivered
      compare: 0
      value: 8
  - id: keeper-4
    text: "...\u0441\u043C\u0435\u043D\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F.
      \u0415\u0441\u043B\u0438 \u043A\u0442\u043E-\u0442\u043E \u0432\u0441\u0451-\u0442\u0430\u043A\u0438
      \u0434\u043E\u0432\u0451\u0437 \u0442\u0443 \u043F\u043E\u0447\u0442\u0443
      \u0441 \u0443\u0437\u043B\u0430 \u2014 \u0441\u043F\u0430\u0441\u0438\u0431\u043E.
      \u042F \u0442\u0430\u043A \u0438 \u0434\u0443\u043C\u0430\u043B, \u0447\u0442\u043E
      \u0434\u043E\u0432\u0435\u0437\u0443\u0442. \u041A\u043E\u043D\u0435\u0446
      \u0437\u0430\u043F\u0438\u0441\u0438. \u041D\u0430\u0447\u0430\u043B\u043E
      \u0437\u0430\u043F\u0438\u0441\u0438."
    conditions:
    - fact: visits.lighthouse
      compare: 0
      value: 3
    - fact: place.lostmail
      compare: 0
      value: 2
  locked: "\u0428\u0438\u043F\u0435\u043D\u0438\u0435. \u0413\u0434\u0435-\u0442\u043E
    \u0433\u043B\u0443\u0431\u043E\u043A\u043E \u0432 \u043D\u0451\u043C \u2014 \u0449\u0435\u043B\u0447\u043A\u0438,
    \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u043A\u0442\u043E-\u0442\u043E
    \u0435\u0449\u0451 \u043D\u0435 \u043D\u0430\u0447\u0430\u043B \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C."
