  m_Script: {fileID: 11500000, guid: ee2fc1bb7ea834e5892fb995a340c7b5, type: 3}
  m_Name: Trickster
  m_EditorClassIdentifier: 
  displayName: "\u0410\u0432\u0430\u043D\u0442\u044E\u0440\u0438\u0441\u0442"
  meetings:
  - at: konbini
    conditions:
    - fact: delivered
      compare: 0
      value: 2
    lines:
    - "\u041E! \u041A\u0443\u0440\u044C\u0435\u0440. \u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439,
      \u0441 \u043A\u043E\u0440\u043E\u0431\u043A\u043E\u0439 \u0438 \u0443\u0441\u0442\u0430\u043B\u044B\u043C\u0438
      \u0443\u0448\u0430\u043C\u0438. \u042F \u0434\u0443\u043C\u0430\u043B, \u0432\u0430\u0441
      \u0443\u0436\u0435 \u043D\u0435 \u0434\u0435\u043B\u0430\u044E\u0442."
    - "\u042F \u0442\u0430\u043A, \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0443\u044E.
      \u0418\u0449\u0443 \u0442\u043E, \u0447\u0442\u043E \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u0434\u043E \u043D\u0430\u0441. \u0417\u0432\u0443\u0447\u0438\u0442 \u043A\u0440\u0430\u0441\u0438\u0432\u043E,
      \u043F\u043B\u0430\u0442\u044F\u0442 \u043F\u043B\u043E\u0445\u043E. \u041F\u043E\u043A\u0430."
    - "\u041F\u043E \u043F\u044B\u043B\u0438 \u043D\u0430 \u0445\u0432\u043E\u0441\u0442\u0435
      \u0432\u0438\u0436\u0443: \u043B\u0435\u0442\u0430\u0435\u0448\u044C \u0434\u0430\u043B\u0435\u043A\u043E.
      \u0415\u0449\u0451 \u0443\u0432\u0438\u0434\u0438\u043C\u0441\u044F, \u043A\u0443\u0440\u044C\u0435\u0440."
    trust: 1
    offer: 0
  - at: fuelstop04
    conditions:
    - fact: delivered
      compare: 0
      value: 5
    lines:
    - "\u041E\u043F\u044F\u0442\u044C \u0442\u044B! \u042D\u0442\u043E \u0441\u0443\u0434\u044C\u0431\u0430
      \u0438\u043B\u0438 \u043C\u0430\u0440\u0448\u0440\u0443\u0442? \u041F\u043E-\u043C\u043E\u0435\u043C\u0443,
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u2014 \u043E\u043D \u043D\u0430\u0434\u0451\u0436\u043D\u0435\u0435."
    - "\u0421\u043A\u043E\u043B\u044C\u043A\u043E \u0442\u0435\u0431\u0435 \u043F\u043B\u0430\u0442\u044F\u0442
      \u0437\u0430 \u043A\u043E\u0440\u043E\u0431\u043A\u0443? \u041D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438.
      \u041F\u043E \u0433\u043B\u0430\u0437\u0430\u043C \u0432\u0438\u0436\u0443:
      \u043C\u0430\u043B\u043E. \u041E\u0431\u0438\u0434\u043D\u043E \u043C\u0430\u043B\u043E."
    - "\u0415\u0441\u0442\u044C \u0434\u0435\u043B\u0430, \u0433\u0434\u0435 \u0437\u0430
      \u043E\u0434\u0438\u043D \u0440\u0435\u0439\u0441 \u043F\u043B\u0430\u0442\u044F\u0442
      \u043A\u0430\u043A \u0437\u0430 \u0433\u043E\u0434. \u042F \u043D\u0435 \u0443\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u044E.
      \u042F \u043F\u0440\u043E\u0441\u0442\u043E \u0432\u0441\u043B\u0443\u0445
      \u0434\u0443\u043C\u0430\u044E."
    trust: 1
    offer: 0
  - at: research
    conditions:
    - fact: debt.paid
      compare: 0
      value: 1
    lines:
    - "\u0423\u0447\u0451\u043D\u044B\u0435 \u0442\u0443\u0442 \u0445\u043E\u0440\u043E\u0448\u0438\u0435.
      \u0421\u043A\u0443\u0447\u043D\u044B\u0435, \u043D\u043E \u0445\u043E\u0440\u043E\u0448\u0438\u0435.
      \u041F\u043E\u043A\u0430\u0437\u0430\u043B \u0438\u043C \u0447\u0435\u0440\u0442\u0451\u0436
      \u2014 \u0442\u0430\u043A \u0434\u043E\u043B\u0433\u043E \u043C\u043E\u043B\u0447\u0430\u043B\u0438,
      \u0447\u0442\u043E \u044F \u043E\u0431\u0438\u0434\u0435\u043B\u0441\u044F."
    - "\u0417\u043D\u0430\u0435\u0448\u044C, \u0447\u0442\u043E \u043B\u0435\u0436\u0438\u0442
      \u043D\u0430 \u0434\u0430\u043B\u044C\u043D\u0435\u0439 \u043E\u043A\u0440\u0430\u0438\u043D\u0435?
      \u0414\u0440\u0435\u0432\u043D\u0435\u0435. \u0421\u0442\u0430\u0440\u0448\u0435
      \u0441\u0442\u0430\u043D\u0446\u0438\u0439, \u0441\u0442\u0430\u0440\u0448\u0435
      \u043F\u043E\u0447\u0442\u044B. \u041C\u043E\u0436\u0435\u0442, \u0441\u0442\u0430\u0440\u0448\u0435
      \u0441\u043A\u0443\u043A\u0438."
    - "\u0415\u0441\u043B\u0438 \u044D\u0442\u043E \u0442\u043E, \u0447\u0442\u043E
      \u044F \u0434\u0443\u043C\u0430\u044E, \u2014 \u044D\u0442\u043E \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u0435.
      \u0418\u043C\u044F \u0432 \u0443\u0447\u0435\u0431\u043D\u0438\u043A\u0430\u0445.
      \u0418 \u0434\u0435\u043D\u044C\u0433\u0438. \u0414\u0435\u043D\u044C\u0433\u0438
      \u0442\u043E\u0436\u0435 \u0432 \u0443\u0447\u0435\u0431\u043D\u0438\u043A\u0430\u0445,
      \u043D\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0435."
    - "\u041D\u0430\u0439\u0434\u0438 \u043C\u0435\u043D\u044F \u043D\u0430 \u041A\u0440\u0430\u044E,
      \u0443 \u0437\u0430\u043F\u0440\u0430\u0432\u043A\u0438 06. \u0422\u0430\u043C
      \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0438\u0445
      \u0443\u0448\u0435\u0439."
    trust: 2
    offer: 0
  - at: fuelstop06
    conditions: []
    lines:
    - "\u041F\u0440\u0438\u043B\u0435\u0442\u0435\u043B. \u042F \u0437\u043D\u0430\u043B.
      \u0422\u043E \u0435\u0441\u0442\u044C \u043D\u0430\u0434\u0435\u044F\u043B\u0441\u044F.
      \u0422\u043E \u0435\u0441\u0442\u044C \u0437\u043D\u0430\u043B."
    - "\u0420\u0443\u0438\u043D\u044B \u043D\u0430 \u0434\u0430\u043B\u044C\u043D\u0435\u0439
      \u043E\u043A\u0440\u0430\u0438\u043D\u0435. \u0422\u0430\u043C \u043B\u0435\u0436\u0438\u0442
      \u043E\u0434\u043D\u0430 \u0432\u0435\u0449\u044C \u2014 \u0443\u0432\u0438\u0434\u0438\u0448\u044C,
      \u0441\u0440\u0430\u0437\u0443 \u043F\u043E\u0439\u043C\u0451\u0448\u044C,
      \u0447\u0442\u043E \u043E\u043D\u0430."
    - "\u041F\u0440\u0438\u0432\u0435\u0437\u0438 \u0435\u0451 \u043C\u043D\u0435.
      \u0414\u0435\u043D\u044C\u0433\u0438 \u2014 \u0447\u0435\u0441\u0442\u043D\u043E
      \u043F\u043E\u043F\u043E\u043B\u0430\u043C. \u041D\u0443, \u043F\u043E\u0447\u0442\u0438
      \u043F\u043E\u043F\u043E\u043B\u0430\u043C. \u041D\u0443, \u0442\u0435\u0431\u0435
      \u0445\u0432\u0430\u0442\u0438\u0442."
    - "\u041A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u044B \u0443\u0436\u0435
      \u0443 \u0442\u0435\u0431\u044F \u043D\u0430 \u043A\u0430\u0440\u0442\u0435.
      \u041B\u0435\u0442\u0438 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E:
      \u0442\u0430\u043C \u0442\u0438\u0445\u043E, \u043A\u0430\u043A \u0432 \u0432\u044B\u043A\u043B\u044E\u0447\u0435\u043D\u043D\u043E\u043C
      \u0440\u0430\u0434\u0438\u043E."
    trust: 1
    offer: 1
  idle:
  - "\u042F \u0442\u0443\u0442 \u043F\u0440\u043E\u0435\u0437\u0434\u043E\u043C.
    \u042F \u0432\u0435\u0437\u0434\u0435 \u043F\u0440\u043E\u0435\u0437\u0434\u043E\u043C."
  - "\u041F\u043E\u0433\u043E\u0434\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F
    \u0445\u043E\u0440\u043E\u0448\u0430\u044F. \u0412 \u043A\u043E\u0441\u043C\u043E\u0441\u0435
    \u043E\u043D\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u0430\u044F,
    \u043D\u043E \u044F \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u0437\u0430\u043C\u0435\u0447\u0430\u044E."
  - "\u0411\u0435\u0440\u0435\u0433\u0438 \u043C\u0430\u0448\u0438\u043D\u0443. \u041E\u043D\u0430
    \u0443 \u0442\u0435\u0431\u044F \u043E\u0434\u043D\u0430. \u041A\u0430\u043A
    \u0438 \u0432\u0441\u0451 \u0445\u043E\u0440\u043E\u0448\u0435\u0435."
  waiting: "\u041D\u0443 \u043A\u0430\u043A, \u0440\u0443\u0438\u043D\u044B? \u042F
    \u0442\u0443\u0442, \u043D\u0438\u043A\u0443\u0434\u0430 \u043D\u0435 \u0434\u0435\u043D\u0443\u0441\u044C.
    \u042D\u0442\u043E \u043C\u043E\u0451 \u043B\u0443\u0447\u0448\u0435\u0435 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E."
  handover: "\u0422\u0451\u043F\u043B\u0430\u044F... \u0422\u0430\u043A \u0438 \u0434\u043E\u043B\u0436\u043D\u043E
    \u0431\u044B\u0442\u044C. \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435. \u0421\u043F\u0430\u0441\u0438\u0431\u043E,
    \u043A\u0443\u0440\u044C\u0435\u0440. \u041D\u0430\u0441\u0447\u0451\u0442 \u0434\u0435\u043D\u0435\u0433
    \u2014 \u0441\u0432\u044F\u0436\u0443\u0441\u044C \u0437\u0430\u0432\u0442\u0440\u0430,
    \u0447\u0435\u0441\u0442\u043D\u043E\u0435 \u0441\u043B\u043E\u0432\u043E. \u041B\u0435\u0442\u0438,
    \u043E\u0442\u0434\u044B\u0445\u0430\u0439."
  afterHandover: "\u0417\u0430\u0432\u0442\u0440\u0430, \u043A\u0443\u0440\u044C\u0435\u0440.
    \u0412\u0441\u0451 \u0437\u0430\u0432\u0442\u0440\u0430. \u041B\u0435\u0442\u0438."
  messages:
  - at: 0
    text: "\u041F\u043E\u0437\u0430\u0434\u0438, \u0443 \u041A\u0440\u0430\u044F,
      \u2014 \u0431\u0435\u0437\u0437\u0432\u0443\u0447\u043D\u0430\u044F \u0432\u0441\u043F\u044B\u0448\u043A\u0430."
  - at: 8
    text: "\u041F\u043E\u0447\u0442\u0430, \u043E\u0431\u0449\u0438\u0439 \u043A\u0430\u043D\u0430\u043B:
      \u0432\u0441\u0435\u043C \u043A\u0443\u0440\u044C\u0435\u0440\u0430\u043C \u0443
      \u041A\u0440\u0430\u044F \u2014 \u0443\u0445\u043E\u0434\u0438\u0442\u0435.
      \u0413\u0440\u0443\u0437 \u043C\u043E\u0436\u043D\u043E \u0431\u0440\u043E\u0441\u0438\u0442\u044C."
  - at: 20
    text: "\u041C\u0430\u043C\u0430: \u041F\u043E \u043D\u043E\u0432\u043E\u0441\u0442\u044F\u043C
      \u0447\u0442\u043E-\u0442\u043E \u043F\u0440\u043E \u041A\u0440\u0430\u0439.
      \u0422\u044B \u0436\u0435 \u043D\u0435 \u0442\u0430\u043C? \u041F\u0435\u0440\u0435\u0437\u0432\u043E\u043D\u0438,
      \u043A\u0430\u043A \u0441\u043C\u043E\u0436\u0435\u0448\u044C."
  - at: 32
    text: "\u041A\u0440\u0435\u0434\u0438\u0442\u043E\u0440\u044B: \u041F\u043B\u0430\u0442\u0451\u0436
      \u0432 \u0441\u0440\u043E\u043A. \u041F\u0440\u0438\u0440\u043E\u0434\u043D\u044B\u0435
      \u044F\u0432\u043B\u0435\u043D\u0438\u044F \u0443\u0432\u0430\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
      \u043F\u0440\u0438\u0447\u0438\u043D\u043E\u0439 \u043D\u0435 \u0441\u0447\u0438\u0442\u0430\u044E\u0442\u0441\u044F."
  - at: 45
    text: "\u041F\u043E\u0447\u0442\u0430: \u041A\u0443\u0440\u044C\u0435\u0440,
      \u0432\u0430\u0448 \u043C\u0430\u044F\u043A \u0434\u0440\u0435\u0439\u0444\u0443\u0435\u0442.
      \u041E\u0442\u0432\u0435\u0442\u044C\u0442\u0435."
  - at: 58
    text: "\u041F\u0430\u043F\u0430: \u041C\u044B \u0442\u0443\u0442, \u0443 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0430.
      \u041C\u044B \u043D\u0438\u043A\u0443\u0434\u0430 \u043D\u0435 \u0443\u0445\u043E\u0434\u0438\u043C."
  - at: 72
    text: "\u041F\u043E\u0447\u0442\u0430: ...\u043A\u0443\u0440\u044C\u0435\u0440...
      \u0441\u0438\u0433\u043D\u0430\u043B... (\u043F\u043E\u043C\u0435\u0445\u0438)"
  - at: 85
    text: "...\u0448-\u0448-\u0448..."
