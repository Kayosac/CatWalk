  after: {fileID: 11400000, guid: 76fa6e0ce77834be39e1cbcf78f4af99, type: 2}
  priority: 96
  repeatable: 0
  reminder: "\u041F\u0430\u043F\u0430 \u043F\u0440\u043E\u0441\u0438\u043B \u0441\u0440\u043E\u0447\u043D\u043E
    \u043F\u0435\u0440\u0435\u0437\u0432\u043E\u043D\u0438\u0442\u044C."
  lines:
  - who: 2
    text: "\u0414\u0432\u043E\u0435 \u0441\u0438\u0434\u0435\u043B\u0438 \u0443 \u043F\u043E\u0434\u044A\u0435\u0437\u0434\u0430.
      \u0412\u0435\u0441\u044C \u0434\u0435\u043D\u044C. \u041D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u0434\u0435\u043B\u0430\u043B\u0438, \u043F\u0440\u043E\u0441\u0442\u043E
      \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438 \u043D\u0430 \u043D\u0430\u0448\u0438
      \u043E\u043A\u043D\u0430."
  - who: 0
    text: "\u041E\u043D\u0438 \u0432\u0430\u0441 \u0442\u0440\u043E\u0433\u0430\u043B\u0438?"
  - who: 2
    text: "\u041D\u0435\u0442. \u041C\u0430\u0442\u044C \u0438\u043C \u0447\u0430\u044E
      \u0432\u044B\u043D\u0435\u0441\u043B\u0430. \u0412\u043E\u0442 \u044D\u0442\u043E\u0433\u043E
      \u044F \u043D\u0435 \u043F\u043E\u043D\u044F\u043B."
  - who: 0
    text: "\u041F\u0430\u043F, \u043C\u043D\u0435 \u043D\u0430 \u0434\u043D\u044F\u0445
      \u0431\u0430\u043A \u0441\u043B\u0438\u043B\u0438 \u043F\u0440\u044F\u043C\u043E
      \u043D\u0430 \u0441\u0442\u043E\u044F\u043D\u043A\u0435, \u0442\u0430\u043A
      \u0447\u0442\u043E \u043E\u043D\u0438 \u0442\u0435\u043F\u0435\u0440\u044C...
      \u041D\u0435\u0432\u0430\u0436\u043D\u043E. \u0421\u0438\u0434\u0438\u0442\u0435
      \u0434\u043E\u043C\u0430."
  - who: 2
    text: "\u041A\u0430\u043A \u044D\u0442\u043E \u2014 \u0431\u0430\u043A \u0441\u043B\u0438\u043B\u0438?"
  - who: 0
    text: "\u041D\u0438\u043A\u0430\u043A. \u0428\u0443\u0442\u043A\u0430 \u0443
      \u043A\u0443\u0440\u044C\u0435\u0440\u043E\u0432 \u0442\u0430\u043A\u0430\u044F.
      \u042F \u0441\u043E\u0431\u0435\u0440\u0443 \u0434\u0435\u043D\u044C\u0433\u0438.
      \u0421\u043A\u043E\u0440\u043E. \u041E\u0431\u0435\u0449\u0430\u044E."
  reveals:
  - "\u0415\u0441\u043B\u0438 \u044F \u0442\u044F\u043D\u0443 \u0441 \u0434\u043E\u043B\u0433\u043E\u043C,
    \u043A\u0440\u0435\u0434\u0438\u0442\u043E\u0440\u044B \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442
    \u043A \u0434\u043E\u043C\u0443 \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0435\u0439.
    \u0418\u043C \u0441\u0442\u0440\u0430\u0448\u043D\u043E. \u041C\u043D\u0435 \u0442\u043E\u0436\u0435,
    \u043D\u043E \u0438\u043C \u044F \u044D\u0442\u043E\u0433\u043E \u043D\u0435
    \u0433\u043E\u0432\u043E\u0440\u044E."
