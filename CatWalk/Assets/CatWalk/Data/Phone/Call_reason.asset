  m_Script: {fileID: 11500000, guid: 5483575af0bd2430d92f87afbdb385ce, type: 3}
  m_Name: Call_reason
  m_EditorClassIdentifier: 
  id: reason
  conditions:
  - fact: debt.paid
    compare: 0
    value: 1200
  after: {fileID: 11400000, guid: 9151d56213c90401d8a3ab0c41c8f40a, type: 2}
  priority: 55
  repeatable: 0
  reminder: "\u041F\u0430\u043F\u0430 \u043F\u0440\u043E\u0441\u0438\u043B \u043F\u0435\u0440\u0435\u0437\u0432\u043E\u043D\u0438\u0442\u044C.
    \u0421\u043A\u0430\u0437\u0430\u043B \u2014 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440
    \u0435\u0441\u0442\u044C."
  lines:
  - who: 2
    text: "\u041C\u044B \u0441 \u043C\u0430\u0442\u0435\u0440\u044C\u044E \u043F\u043E\u0441\u0447\u0438\u0442\u0430\u043B\u0438,
      \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0442\u044B \u0443\u0436\u0435
      \u043E\u0442\u0434\u0430\u043B. \u041C\u043D\u043E\u0433\u043E."
  - who: 0
    text: "\u041E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u0435\u0449\u0451 \u0431\u043E\u043B\u044C\u0448\u0435.
      \u041D\u0435 \u0441\u0447\u0438\u0442\u0430\u0439\u0442\u0435, \u043F\u0430\u043F,
      \u044D\u0442\u043E \u0441\u043A\u0443\u0447\u043D\u043E."
  - who: 2
    text: "\u0421\u044B\u043D. \u042D\u0442\u043E \u0432\u0435\u0434\u044C \u0437\u0430
      \u0435\u0451 \u043B\u0435\u0447\u0435\u043D\u0438\u0435. \u0422\u044B \u043E\u0434\u0438\u043D
      \u0432\u0441\u0451 \u043D\u0430 \u0441\u0435\u0431\u044F \u0432\u0437\u044F\u043B."
  - who: 0
    text: "\u041A\u043B\u0438\u043D\u0438\u043A\u0430 \u043D\u0435 \u0436\u0434\u0430\u043B\u0430.
      \u0411\u0430\u043D\u043A \u0436\u0434\u0430\u043B \u043C\u0435\u043D\u044C\u0448\u0435
      \u0432\u0441\u0435\u0445. \u042F \u0431\u044B \u0441\u043D\u043E\u0432\u0430
      \u043F\u043E\u0448\u0451\u043B \u0438 \u0441\u043D\u043E\u0432\u0430 \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u043B."
  - who: 2
    text: "\u0417\u043D\u0430\u044E. \u041F\u043E\u0442\u043E\u043C\u0443 \u0438
      \u0437\u0432\u043E\u043D\u044E. \u0421\u043A\u0430\u0437\u0430\u0442\u044C,
      \u0447\u0442\u043E \u0437\u043D\u0430\u044E."
  - who: 0
    text: "...\u0421\u043F\u0430\u0441\u0438\u0431\u043E. \u041B\u0430\u0434\u043D\u043E.
      \u041C\u043D\u0435 \u043D\u0430 \u0440\u0435\u0439\u0441."
  reveals:
  - "\u041E\u0433\u0440\u043E\u043C\u043D\u044B\u0439 \u043A\u0440\u0435\u0434\u0438\u0442
    \u044F \u0432\u0437\u044F\u043B \u0441\u0430\u043C \u2014 \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u043E\u0435
    \u043B\u0435\u0447\u0435\u043D\u0438\u0435 \u043C\u043B\u0430\u0434\u0448\u0435\u0439
    \u0441\u0435\u0441\u0442\u0440\u044B."
