  id: sister
  conditions:
  - fact: delivered
    compare: 0
    value: 10
  after: {fileID: 11400000, guid: 1344eb81732614f78b174ac7648ccfc1, type: 2}
  priority: 60
  repeatable: 0
  reminder: "\u041C\u0430\u043C\u0430 \u043F\u0440\u043E\u0441\u0438\u043B\u0430
    \u043F\u0435\u0440\u0435\u0437\u0432\u043E\u043D\u0438\u0442\u044C. \u041F\u0440\u043E\u0441\u0442\u043E
    \u0442\u0430\u043A, \u0433\u043E\u0432\u043E\u0440\u0438\u0442."
  lines:
  - who: 1
    text: "\u042F \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043F\u0435\u043A\u043B\u0430
      \u0442\u0435 \u0431\u0443\u043B\u043E\u0447\u043A\u0438. \u0421 \u043C\u0430\u043A\u043E\u043C.
      \u041A\u043E\u0442\u043E\u0440\u044B\u0435 \u043E\u043D\u0430 \u043B\u044E\u0431\u0438\u043B\u0430."
  - who: 0
    text: ...
  - who: 1
    text: "\u041F\u043E\u043B\u0443\u0447\u0438\u043B\u0438\u0441\u044C. \u0426\u0435\u043B\u044B\u0439
      \u043F\u0440\u043E\u0442\u0438\u0432\u0435\u043D\u044C. \u041F\u0430\u043F\u0430
      \u0441\u044A\u0435\u043B \u0442\u0440\u0438 \u0438 \u0432\u043E\u0440\u0447\u0438\u0442,
      \u0447\u0442\u043E \u043C\u0430\u043B\u043E \u043C\u0430\u043A\u0430."
  - who: 0
    text: "\u041C\u0430\u043C... \u0423 \u043C\u0435\u043D\u044F \u0442\u0443\u0442
      \u0437\u0430\u043A\u0430\u0437. \u0425\u0440\u0443\u043F\u043A\u0438\u0439.
      \u041F\u043E\u0442\u043E\u043C \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C,
      \u043B\u0430\u0434\u043D\u043E?"
  - who: 1
    text: "\u041B\u0430\u0434\u043D\u043E. \u042F \u0442\u0435\u0431\u0435 \u043E\u0434\u043D\u0443
      \u043E\u0441\u0442\u0430\u0432\u043B\u044E. \u0417\u0430\u0441\u0443\u0448\u0443,
      \u043A\u0430\u043A \u0440\u0430\u043D\u044C\u0448\u0435."
  reveals:
  - "\u041C\u0430\u043C\u0430 \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u043B\u0430
    \u043C\u043B\u0430\u0434\u0448\u0443\u044E \u0441\u0435\u0441\u0442\u0440\u0443.
    \u042F \u0441\u043E\u0441\u043B\u0430\u043B\u0441\u044F \u043D\u0430 \u0437\u0430\u043A\u0430\u0437
    \u0438 \u043D\u0435 \u0441\u0442\u0430\u043B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0442\u044C."
