  after: {fileID: 11400000, guid: 5ae6b73d29bc8474f82a047269232720, type: 2}
  priority: 65
  repeatable: 0
  reminder: "\u041F\u0430\u043F\u0430 \u043F\u0440\u043E\u0441\u0438\u043B \u043F\u0435\u0440\u0435\u0437\u0432\u043E\u043D\u0438\u0442\u044C.
    \u0413\u043E\u043B\u043E\u0441 \u0431\u043E\u0434\u0440\u044B\u0439."
  lines:
  - who: 0
    text: "\u041F\u0430\u043F, \u044F \u0442\u0440\u0435\u0442\u044C \u043E\u0442\u0434\u0430\u043B.
      \u0422\u0440\u0435\u0442\u044C!"
  - who: 2
    text: "\u041C\u0430\u0442\u044C! \u0422\u0440\u0435\u0442\u044C! ...\u041E\u043D\u0430
      \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442, \u0442\u0440\u0435\u0442\u044C
      \u0447\u0435\u0433\u043E."
  - who: 0
    text: "\u0412\u0441\u0435\u0433\u043E. \u0421\u043A\u0430\u0436\u0438 \u2014
      \u0442\u0440\u0435\u0442\u044C \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u0433\u043E."
  - who: 2
    text: "\u042F \u043E\u0442\u043A\u0440\u044B\u043B \u0442\u0443 \u0431\u0443\u0442\u044B\u043B\u043A\u0443.
      \u041B\u0438\u043C\u043E\u043D\u0430\u0434\u0430. \u0411\u0435\u0440\u0451\u0433
      \u043D\u0430 \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A."
  - who: 0
    text: "\u0421\u043A\u043E\u043B\u044C\u043A\u043E \u043B\u0435\u0442 \u0431\u0435\u0440\u0451\u0433?"
  - who: 2
    text: "\u041D\u0435 \u0442\u0432\u043E\u0451 \u0434\u0435\u043B\u043E. \u041F\u0443\u0437\u044B\u0440\u044C\u043A\u0438
      \u0435\u0449\u0451 \u0435\u0441\u0442\u044C. \u041F\u043E\u0447\u0442\u0438."
  reveals:
  - "\u0422\u0440\u0435\u0442\u044C \u0434\u043E\u043B\u0433\u0430 \u0432\u044B\u043F\u043B\u0430\u0447\u0435\u043D\u0430.
    \u041F\u0430\u043F\u0430 \u043E\u0442\u043A\u0440\u044B\u043B \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u0447\u043D\u044B\u0439
    \u043B\u0438\u043C\u043E\u043D\u0430\u0434."
