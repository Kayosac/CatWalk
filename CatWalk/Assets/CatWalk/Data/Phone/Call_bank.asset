  m_Script: {fileID: 11500000, guid: 5483575af0bd2430d92f87afbdb385ce, type: 3}
  m_Name: Call_bank
  m_EditorClassIdentifier: 
  id: bank
  conditions:
  - fact: delivered
    compare: 0
    value: 6
  after: {fileID: 11400000, guid: 50201f47137e646dfbd945fdecfaa48a, type: 2}
  priority: 80
  repeatable: 0
  reminder: "\u041C\u0430\u043C\u0430 \u043F\u0440\u043E\u0441\u0438\u043B\u0430
    \u043F\u0435\u0440\u0435\u0437\u0432\u043E\u043D\u0438\u0442\u044C."
  lines:
  - who: 1
    text: "\u0422\u0443\u0442 \u043F\u0438\u0441\u044C\u043C\u043E \u043F\u0440\u0438\u0448\u043B\u043E.
      \u041D\u0430 \u0442\u0432\u043E\u0451 \u0438\u043C\u044F. \u041D\u0435 \u0438\u0437
      \u0431\u0430\u043D\u043A\u0430 \u2014 \u0438\u0437 \u043A\u0430\u043A\u043E\u0439-\u0442\u043E
      \u043A\u043E\u043D\u0442\u043E\u0440\u044B."
  - who: 0
    text: "\u041D\u0435 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0439, \u043C\u0430\u043C.
      \u041F\u043E\u043B\u043E\u0436\u0438 \u0432 \u044F\u0449\u0438\u043A."
  - who: 1
    text: "\u042F \u0443\u0436\u0435 \u043E\u0442\u043A\u0440\u044B\u043B\u0430.
      \u041D\u0430\u043F\u0438\u0441\u0430\u043D\u043E, \u0447\u0442\u043E \u0442\u0435\u043F\u0435\u0440\u044C
      \u043E\u043D\u0438 \u0432\u043C\u0435\u0441\u0442\u043E \u0431\u0430\u043D\u043A\u0430.
      \u042D\u0442\u043E \u043A\u0430\u043A?"
  - who: 0
    text: "\u042D\u0442\u043E \u0437\u043D\u0430\u0447\u0438\u0442, \u0443 \u043C\u043E\u0435\u0433\u043E
      \u043A\u0440\u0435\u0434\u0438\u0442\u0430 \u043D\u043E\u0432\u044B\u0439 \u0445\u043E\u0437\u044F\u0438\u043D.
      \u0411\u044B\u0432\u0430\u0435\u0442. \u041A\u0430\u043A \u0443 \u043A\u043E\u0442\u0430
      \u2014 \u043F\u0435\u0440\u0435\u0435\u0437\u0434."
  - who: 1
    text: "\u0422\u044B \u0431\u044B \u0441\u043A\u0430\u0437\u0430\u043B, \u0435\u0441\u043B\u0438
      \u0447\u0442\u043E-\u0442\u043E \u043F\u043B\u043E\u0445\u043E\u0435?"
  - who: 0
    text: "\u0421\u043A\u0430\u0437\u0430\u043B \u0431\u044B. \u041D\u0438\u0447\u0435\u0433\u043E
      \u043F\u043B\u043E\u0445\u043E\u0433\u043E, \u043F\u0440\u043E\u0441\u0442\u043E
      \u0431\u0443\u043C\u0430\u0436\u043A\u0438. \u041C\u0430\u043C, \u0443 \u043C\u0435\u043D\u044F
      \u0437\u0430\u043F\u0440\u0430\u0432\u043A\u0430, \u044F \u043F\u043E\u0431\u0435\u0436\u0430\u043B."
  reveals:
  - "\u0423 \u043C\u0435\u043D\u044F \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043A\u0440\u0435\u0434\u0438\u0442.
    \u0411\u0430\u043D\u043A \u043F\u0440\u043E\u0434\u0430\u043B \u0435\u0433\u043E
    \u043A\u0430\u043A\u043E\u0439-\u0442\u043E \u043A\u043E\u043D\u0442\u043E\u0440\u0435
    \u2014 \u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0442\u0435\u043F\u0435\u0440\u044C
    \u0438\u043C."
