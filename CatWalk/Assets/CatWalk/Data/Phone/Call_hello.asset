--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5483575af0bd2430d92f87afbdb385ce, type: 3}
  m_Name: Call_hello
  m_EditorClassIdentifier: 
  id: hello
  conditions: []
  after: {fileID: 0}
  priority: 100
  repeatable: 0
  reminder: 
  lines:
  - who: 1
    text: "\u0410\u043B\u043B\u043E? \u0410\u043B\u043B\u043E! \u042D\u0442\u043E
      \u0442\u044B? \u041E\u0442\u0435\u0446, \u044D\u0442\u043E \u043E\u043D!"
  - who: 0
    text: "\u042D\u0442\u043E \u044F, \u043C\u0430\u043C. \u0417\u0432\u043E\u043D\u044E
      \u0438\u0437 \u0431\u0443\u0434\u043A\u0438 \u043D\u0430 \u0441\u0442\u0430\u043D\u0446\u0438\u0438.
      \u0422\u0443\u0442 \u043F\u0430\u0445\u043D\u0435\u0442 \u043B\u0430\u043F\u0448\u043E\u0439
      \u0438 \u043E\u0437\u043E\u043D\u043E\u043C."
  - who: 1
    text: "\u0422\u044B \u0442\u0430\u043C \u0435\u0448\u044C? \u041D\u0435 \u043E\u0434\u043D\u0443
      \u043B\u0430\u043F\u0448\u0443?"
  - who: 0
    text: "\u0415\u0449\u0451 \u043E\u0437\u043E\u043D. \u0428\u0443\u0447\u0443.
      \u0415\u043C \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E. \u0421\u043D\u043E\u0432\u0430
      \u0432\u043E\u0436\u0443 \u043F\u043E\u0447\u0442\u0443 \u2014 \u043C\u0430\u0448\u0438\u043D\u0430
      \u0442\u0451\u043F\u043B\u0430\u044F, \u043C\u0435\u0441\u0442\u0430 \u0445\u0432\u0430\u0442\u0430\u0435\u0442."
  - who: 2
    text: "\u0420\u0430\u0437 \u0442\u0451\u043F\u043B\u0430\u044F \u2014 \u0436\u0438\u0432\u0451\u043C.
      \u0422\u044B \u0437\u0432\u043E\u043D\u0438, \u0441\u043B\u044B\u0448\u0438\u0448\u044C?
      \u041C\u0430\u0442\u044C \u0432\u043E\u043D \u0443 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0430
      \u0434\u0435\u0436\u0443\u0440\u0438\u0442."
  - who: 1
    text: "\u041D\u0435 \u0434\u0435\u0436\u0443\u0440\u044E. \u041F\u0440\u043E\u0441\u0442\u043E
      \u0440\u044F\u0434\u043E\u043C \u0441\u0438\u0436\u0443. \u0422\u0443\u0442
      \u0443\u0434\u043E\u0431\u043D\u043E."
  - who: 0
    text: "\u0411\u0443\u0434\u0443 \u0437\u0432\u043E\u043D\u0438\u0442\u044C. \u0421
      \u043A\u0430\u0436\u0434\u043E\u0439 \u0431\u0443\u0434\u043A\u0438, \u0433\u0434\u0435
      \u0435\u0441\u0442\u044C \u0433\u0443\u0434\u043E\u043A."
  reveals:
  - "\u042F \u0441\u043D\u043E\u0432\u0430 \u0432\u043E\u0436\u0443 \u043F\u043E\u0447\u0442\u0443
    \u0438 \u0436\u0438\u0432\u0443 \u0432 \u043C\u0430\u0448\u0438\u043D\u0435.
    \u0420\u043E\u0434\u0438\u0442\u0435\u043B\u044F\u043C \u0437\u0432\u043E\u043D\u044E
    \u0438\u0437 \u0431\u0443\u0434\u043E\u043A \u043D\u0430 \u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445."
