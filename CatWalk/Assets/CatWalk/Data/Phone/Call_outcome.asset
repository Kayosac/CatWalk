  after: {fileID: 11400000, guid: 7e46a1c4dd5884cd5b601593e414f34d, type: 2}
  priority: 50
  repeatable: 0
  reminder: "\u041C\u0430\u043C\u0430 \u043F\u0440\u043E\u0441\u0438\u043B\u0430
    \u043F\u043E\u0437\u0432\u043E\u043D\u0438\u0442\u044C \u0432\u0435\u0447\u0435\u0440\u043E\u043C."
  lines:
  - who: 1
    text: "\u041F\u0430\u043F\u0430 \u043F\u043E\u0447\u0438\u043D\u0438\u043B \u0435\u0451
      \u0432\u0435\u043B\u043E\u0441\u0438\u043F\u0435\u0434. \u0417\u0430\u0447\u0435\u043C
      \u2014 \u0441\u0430\u043C \u043D\u0435 \u0437\u043D\u0430\u0435\u0442. \u0421\u0442\u043E\u0438\u0442
      \u0432 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0435."
  - who: 0
    text: "\u041F\u0443\u0441\u0442\u044C \u0441\u0442\u043E\u0438\u0442."
  - who: 1
    text: "\u042F \u0432\u0441\u0451 \u0434\u0443\u043C\u0430\u044E: \u043C\u043E\u0436\u0435\u0442,
      \u0434\u0440\u0443\u0433\u0430\u044F \u043A\u043B\u0438\u043D\u0438\u043A\u0430...
      \u041C\u043E\u0436\u0435\u0442, \u0440\u0430\u043D\u044C\u0448\u0435 \u043D\u0430\u0434\u043E
      \u0431\u044B\u043B\u043E..."
  - who: 0
    text: "\u041C\u0430\u043C. \u041C\u044B \u0441\u0434\u0435\u043B\u0430\u043B\u0438
      \u0432\u0441\u0451. \u0418 \u0432\u0440\u0430\u0447\u0438 \u0441\u0434\u0435\u043B\u0430\u043B\u0438.
      \u041B\u0435\u0447\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043D\u0435 \u043F\u043E\u043C\u043E\u0433\u043B\u043E. \u0422\u0430\u043A
      \u0431\u044B\u0432\u0430\u0435\u0442."
  - who: 1
    text: "\u0422\u044B \u0442\u0430\u043A \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E
      \u0433\u043E\u0432\u043E\u0440\u0438\u0448\u044C."
  - who: 0
    text: "\u0414\u043E\u043B\u0433\u043E \u0443\u0447\u0438\u043B\u0441\u044F \u0442\u0430\u043A
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C. \u041F\u043E\u0437\u0432\u043E\u043D\u044E
      \u043D\u0430 \u043D\u0435\u0434\u0435\u043B\u0435."
  - who: 1
    text: "\u0422\u044B \u0432\u0441\u0435\u0433\u0434\u0430 \u0442\u0430\u043A \u0433\u043E\u0432\u043E\u0440\u0438\u0448\u044C."
  - who: 0
    text: "\u0418 \u0432\u0441\u0435\u0433\u0434\u0430 \u0437\u0432\u043E\u043D\u044E."
  reveals:
  - "\u041B\u0435\u0447\u0435\u043D\u0438\u0435 \u043D\u0435 \u043F\u043E\u043C\u043E\u0433\u043B\u043E.
    \u0421\u0435\u0441\u0442\u0440\u044B \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435\u0442.
    \u0414\u043E\u043B\u0433 \u043E\u0441\u0442\u0430\u043B\u0441\u044F."
