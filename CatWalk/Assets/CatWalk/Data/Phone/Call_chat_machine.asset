  lines:
  - who: 3
    text: "\u0412\u044B \u043F\u043E\u0437\u0432\u043E\u043D\u0438\u043B\u0438...
      \u041E\u0442\u0435\u0446, \u043A\u0443\u0434\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C?
      ...\u0413\u043E\u0432\u043E\u0440\u0438\u0442\u0435 \u043F\u043E\u0441\u043B\u0435
      \u0441\u0438\u0433\u043D\u0430\u043B\u0430. \u0411\u0438-\u0438\u043F. \u042D\u0442\u043E
      \u044F \u0441\u043A\u0430\u0437\u0430\u043B\u0430 \xAB\u0431\u0438-\u0438\u043F\xBB,
      \u0441\u0438\u0433\u043D\u0430\u043B\u0430 \u043D\u0435\u0442."
  - who: 0
    text: "\u041F\u0440\u0438\u0432\u0435\u0442, \u044D\u0442\u043E \u044F. \u0416\u0438\u0432,
      \u0441\u044B\u0442, \u043B\u0435\u0447\u0443. \u041F\u0435\u0440\u0435\u0437\u0432\u043E\u043D\u044E.
      \u0410\u0432\u0442\u043E\u043E\u0442\u0432\u0435\u0442\u0447\u0438\u043A \u0443
      \u0432\u0430\u0441 \u043E\u0442\u043B\u0438\u0447\u043D\u044B\u0439."
  reveals: []
