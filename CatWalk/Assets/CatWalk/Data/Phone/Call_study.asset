  m_Script: {fileID: 11500000, guid: 5483575af0bd2430d92f87afbdb385ce, type: 3}
  m_Name: Call_study
  m_EditorClassIdentifier: 
  id: study
  conditions:
  - fact: delivered
    compare: 0
    value: 3
  after: {fileID: 11400000, guid: 5ae6b73d29bc8474f82a047269232720, type: 2}
  priority: 90
  repeatable: 0
  reminder: "\u041F\u0430\u043F\u0430 \u043F\u0440\u043E\u0441\u0438\u043B \u043F\u0435\u0440\u0435\u0437\u0432\u043E\u043D\u0438\u0442\u044C.
    \u0413\u043E\u0432\u043E\u0440\u0438\u0442, \xAB\u043F\u043E \u0434\u0435\u043B\u0443\xBB."
  lines:
  - who: 2
    text: "\u041D\u0443 \u0447\u0442\u043E, \u043F\u043E\u0447\u0442\u0430\u043B\u044C\u043E\u043D.
      \u0421\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u0440\u0430\u0437\u0432\u0451\u0437?"
  - who: 0
    text: "\u0422\u0440\u0438. \u041E\u0434\u043D\u0443 \u0445\u0440\u0443\u043F\u043A\u0443\u044E.
      \u0414\u043E\u0432\u0451\u0437 \u0446\u0435\u043B\u043E\u0439, \u043F\u043E\u0447\u0442\u0438
      \u0433\u043E\u0440\u0436\u0443\u0441\u044C."
  - who: 2
    text: "\u0410 \u0443\u0447\u0451\u0431\u0430 \u0442\u0432\u043E\u044F? \u0422\u044B
      \u0436\u0435 \u0443\u0435\u0437\u0436\u0430\u043B \u0443\u0447\u0438\u0442\u044C\u0441\u044F.
      \u041A\u043D\u0438\u0436\u043A\u0438 \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440
      \u0432 \u043A\u043E\u0440\u043E\u0431\u043A\u0435 \u0441\u0442\u043E\u044F\u0442."
  - who: 0
    text: "\u0423\u0447\u0451\u0431\u0430 \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u0442,
      \u043F\u0430\u043F. \u041A\u043D\u0438\u0436\u043A\u0438 \u0442\u0435\u0440\u043F\u0435\u043B\u0438\u0432\u044B\u0435."
  - who: 2
    text: "\u041E\u043D\u0438-\u0442\u043E \u0442\u0435\u0440\u043F\u0435\u043B\u0438\u0432\u044B\u0435.
      \u0422\u044B \u0432\u043E\u0442 \u0443 \u043D\u0430\u0441 \u2014 \u043D\u0435
      \u043E\u0447\u0435\u043D\u044C."
  - who: 0
    text: "\u041F\u043E\u0442\u043E\u043C\u0443 \u0438 \u0432\u043E\u0436\u0443 \u043F\u043E\u0447\u0442\u0443.
      \u0411\u044B\u0441\u0442\u0440\u043E, \u0437\u0430\u043A\u043E\u043D\u043D\u043E,
      \u0431\u0435\u0437 \u044D\u043A\u0437\u0430\u043C\u0435\u043D\u043E\u0432."
  reveals:
  - "\u041A\u043E\u0433\u0434\u0430-\u0442\u043E \u044F \u0443\u0435\u0445\u0430\u043B
    \u0443\u0447\u0438\u0442\u044C\u0441\u044F. \u041F\u0440\u043E\u0443\u0447\u0438\u043B\u0441\u044F
    \u043D\u0435\u0434\u043E\u043B\u0433\u043E \u2014 \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
    \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u0440\u0435\u0439\u0441\u0430\u043C."
