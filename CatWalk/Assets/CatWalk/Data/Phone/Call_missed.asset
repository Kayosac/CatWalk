  after: {fileID: 11400000, guid: 5ae6b73d29bc8474f82a047269232720, type: 2}
  priority: 85
  repeatable: 0
  reminder: "\u041F\u0430\u043F\u0430 \u0437\u0432\u043E\u043D\u0438\u043B. \u041F\u0440\u043E\u0441\u0438\u043B
    \u043F\u0435\u0440\u0435\u0437\u0432\u043E\u043D\u0438\u0442\u044C, \xAB\u043A\u0430\u043A
    \u0441\u043C\u043E\u0436\u0435\u0448\u044C\xBB."
  lines:
  - who: 2
    text: "\u041D\u0430\u043C \u0437\u0432\u043E\u043D\u0438\u043B\u0438. \u0412\u0435\u0436\u043B\u0438\u0432\u043E
      \u0442\u0430\u043A. \u0421\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u043B\u0438,
      \u0433\u0434\u0435 \u0442\u044B \u0438 \u0432\u0441\u0451 \u043B\u0438 \u0443
      \u0442\u0435\u0431\u044F \u0445\u043E\u0440\u043E\u0448\u043E."
  - who: 0
    text: "...\u0427\u0442\u043E \u0442\u044B \u0438\u043C \u0441\u043A\u0430\u0437\u0430\u043B?"
  - who: 2
    text: "\u0427\u0442\u043E \u0445\u043E\u0440\u043E\u0448\u043E. \u0410 \u0447\u0442\u043E,
      \u043D\u0435 \u0445\u043E\u0440\u043E\u0448\u043E?"
  - who: 0
    text: "\u0425\u043E\u0440\u043E\u0448\u043E. \u041E\u043F\u043E\u0437\u0434\u0430\u043B
      \u0441 \u043F\u043B\u0430\u0442\u0435\u0436\u043E\u043C, \u0432\u043E\u0442
      \u0438 \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u044F\u0442\u0441\u044F.
      \u0417\u0430\u0431\u043E\u0442\u043B\u0438\u0432\u044B\u0435."
  - who: 2
    text: "\u0417\u0430\u0431\u043E\u0442\u043B\u0438\u0432\u044B\u0435 \u0442\u0430\u043A
      \u043D\u0435 \u0434\u044B\u0448\u0430\u0442 \u0432 \u0442\u0440\u0443\u0431\u043A\u0443."
  - who: 0
    text: "\u041F\u0430\u043F. \u0421 \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0445
      \u043D\u043E\u043C\u0435\u0440\u043E\u0432 \u043D\u0435 \u0431\u0435\u0440\u0438\u0442\u0435.
      \u042F \u0441\u0430\u043C \u0437\u0430\u043F\u043B\u0430\u0447\u0443, \u044D\u0442\u043E
      \u043C\u043E\u0451."
  reveals:
  - "\u041A\u043E\u0433\u0434\u0430 \u044F \u043E\u043F\u0430\u0437\u0434\u044B\u0432\u0430\u044E
    \u0441 \u043F\u043B\u0430\u0442\u0435\u0436\u043E\u043C, \u043A\u0440\u0435\u0434\u0438\u0442\u043E\u0440\u044B
    \u0437\u0432\u043E\u043D\u044F\u0442 \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u044F\u043C."
