  after: {fileID: 11400000, guid: 5ae6b73d29bc8474f82a047269232720, type: 2}
  priority: 95
  repeatable: 0
  reminder: "\u041C\u0430\u043C\u0430 \u0437\u0432\u043E\u043D\u0438\u043B\u0430
    \u0442\u0440\u0438 \u0440\u0430\u0437\u0430. \u041F\u0440\u043E\u0441\u0438\u043B\u0430
    \u043F\u0435\u0440\u0435\u0437\u0432\u043E\u043D\u0438\u0442\u044C."
  lines:
  - who: 1
    text: "\u041F\u043E\u0434 \u0434\u0432\u0435\u0440\u044C\u044E \u0437\u0430\u043F\u0438\u0441\u043A\u0430.
      \u0411\u0435\u0437 \u043F\u043E\u0434\u043F\u0438\u0441\u0438. \xAB\u041F\u0440\u0438\u0432\u0435\u0442
      \u0441\u044B\u043D\u0443\xBB. \u0418 \u0432\u0441\u0451."
  - who: 0
    text: "\u041F\u043E\u0440\u0432\u0438 \u0438 \u0432\u044B\u043A\u0438\u043D\u044C."
  - who: 1
    text: "\u042F \u0435\u0451 \u043D\u0430 \u0445\u043E\u043B\u043E\u0434\u0438\u043B\u044C\u043D\u0438\u043A
      \u043F\u043E\u0432\u0435\u0441\u0438\u043B\u0430. \u041F\u043E\u0447\u0435\u0440\u043A
      \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0439."
  - who: 0
    text: "\u041C\u0430\u043C. \u0421\u043D\u0438\u043C\u0438. \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430.
      \u0418 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0439\u0442\u0435 \u0434\u0432\u0435\u0440\u044C
      \u043D\u0430 \u043E\u0431\u0430 \u0437\u0430\u043C\u043A\u0430."
  - who: 1
    text: "\u0422\u044B \u0447\u0442\u043E-\u0442\u043E \u043D\u0435 \u0434\u043E\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u0448\u044C."
  - who: 0
    text: "\u0414\u043E\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u044E. \u041F\u043E\u0447\u0435\u0440\u043A
      \u043F\u0440\u0430\u0432\u0434\u0430 \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0439.
      \u0412\u0441\u0451 \u0445\u043E\u0440\u043E\u0448\u043E. \u042F \u0437\u0430\u043F\u043B\u0430\u0447\u0443,
      \u0441\u043A\u043E\u0440\u043E."
  reveals:
  - "\u041A\u0440\u0435\u0434\u0438\u0442\u043E\u0440\u044B \u0437\u043D\u0430\u044E\u0442,
    \u0433\u0434\u0435 \u0436\u0438\u0432\u0443\u0442 \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0438.
    \u0417\u0430\u043F\u0438\u0441\u043A\u0430 \u043F\u043E\u0434 \u0434\u0432\u0435\u0440\u044C\u044E
    \u2014 \u0438\u0445 \xAB\u043F\u0440\u0438\u0432\u0435\u0442\xBB."
