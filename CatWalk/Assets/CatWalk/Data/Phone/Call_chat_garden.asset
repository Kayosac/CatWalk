  id: chat_garden
  conditions: []
  after: {fileID: 11400000, guid: 5ae6b73d29bc8474f82a047269232720, type: 2}
  priority: 0
  repeatable: 1
  reminder: 
  lines:
  - who: 1
    text: "\u0410 \u0443 \u043D\u0430\u0441 \u043A\u0430\u0431\u0430\u0447\u043A\u0438.
      \u0412\u043E\u0441\u0435\u043C\u044C \u0448\u0442\u0443\u043A. \u041A\u0443\u0434\u0430
      \u0438\u0445 \u2014 \u043D\u0435 \u0437\u043D\u0430\u044E."
  - who: 0
    text: "\u041F\u0440\u0438\u0448\u043B\u0438 \u043F\u043E\u0441\u044B\u043B\u043A\u043E\u0439.
      \u042F \u0437\u043D\u0430\u044E \u0445\u043E\u0440\u043E\u0448\u0443\u044E
      \u043F\u043E\u0447\u0442\u0443."
  - who: 1
    text: "\u0422\u0430\u043A \u0442\u044B \u0436\u0435 \u0435\u0451 \u0441\u0430\u043C
      \u0438 \u043F\u0440\u0438\u0432\u0435\u0437\u0451\u0448\u044C!"
  - who: 0
    text: "\u0412\u043E\u0442 \u0438 \u043A\u0440\u0443\u0433\u043E\u0432\u043E\u0440\u043E\u0442
      \u043A\u0430\u0431\u0430\u0447\u043A\u043E\u0432 \u0432 \u043F\u0440\u0438\u0440\u043E\u0434\u0435."
  - who: 1
    text: "\u0415\u0448\u044C \u0442\u0430\u043C. \u0426\u0435\u043B\u0443\u044E.
      \u041F\u0430\u043F\u0430 \u0442\u043E\u0436\u0435 \u0446\u0435\u043B\u0443\u0435\u0442,
      \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u0442\u0435\u0441\u043D\u044F\u0435\u0442\u0441\u044F."
  reveals: []
